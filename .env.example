# Copy to .env and tweak for your deploy host. docker compose picks .env
# up automatically; the build-time NEXT_PUBLIC_* values are forwarded into
# the portal Dockerfile via build args.

# JWT secret — override in any prod deploy.
JWT_SECRET=delivery-sim-dev-secret-not-for-production

# Temporal API key — only set when pointing at Temporal Cloud (or any
# auth-protected cluster). Leave blank for the bundled self-hosted
# Temporal in docker-compose. When set, TLS is auto-enabled on the
# client + worker connections.
TEMPORAL_API_KEY=

# What the BROWSER uses to reach the API. Localhost is correct for a dev
# host; for prod set this to your public API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:14001

# `real` hits the API; `mock` keeps the portal self-contained for demos.
NEXT_PUBLIC_API_MODE=real
